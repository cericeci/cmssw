<!-- host-only plugins -->
<library file="*.cc" name="RecoVertexPortablePrimaryVertexProducerPlugins">
  <use name="DataFormats/Math"/>
  <use name="DataFormats/VertexSoA"/>
  <use name="DataFormats/TrackReco"/>
  <use name="DataFormats/VertexReco"/>
  <use name="FWCore/Framework"/>
  <use name="FWCore/ParameterSet"/>
  <use name="FWCore/Utilities"/>
  <flags EDM_PLUGIN="1"/>
</library>

<!-- alpaka-based portable plugins -->
<library file="alpaka/*.cc" name="RecoVertexPortablePrimaryVertexProducerPluginsportable">
  <use name="alpaka"/>
  <!--
  The dependency on "DataFormats/VertexSoA" automatically expands to include
  the host-only library (if it exists) and the corresponding Alpaka libraries (if they exist)
  -->
  <use name="DataFormats/VertexSoA"/>
  <use name="DataFormats/TrackReco"/>
  <use name="DataFormats/VertexReco"/>
  <use name="DataFormats/BeamSpot"/>
  <use name="FWCore/Framework"/>
  <use name="FWCore/ParameterSet"/>
  <use name="FWCore/Utilities"/>
  <use name="HeterogeneousCore/AlpakaCore"/>
  <use name="HeterogeneousCore/AlpakaInterface"/>
  <use name="TrackingTools/Records"/>
  <use name="TrackingTools/TransientTrack"/>
  <flags ALPAKA_BACKENDS="1"/>
  <flags EDM_PLUGIN="1"/>
</library>
